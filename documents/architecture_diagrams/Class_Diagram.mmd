    <<built script>>
    +crop_fundus(image)
    +preprocess_image(input_path, output_path)
  }
  class SharedResNetBackbone {
    <<built>>
    +forward(x) features
  }
  class DualNet {
    <<built>>
    +backbone SharedResNetBackbone
    +cataract_head Linear
    +glaucoma_head Linear
    +forward(x) scores
  }
  class GlaucomaNet {
    <<built>>
    +backbone SharedResNetBackbone
    +glaucoma_head Linear
    +forward(x) glaucoma score
  }
  class CataractOnlyNet {
    <<built>>
    +backbone SharedResNetBackbone
    +cataract_head Linear
    +forward(x) cataract score
  }
  class FundusDataset {
    <<built ODIR only>>
    +labels_csv eye_labels_task7.csv
    +image_dir
    +split
    +transform
    +len(dataset)
    +dataset[index] image, labels
  }
  class train_dual {
    <<built script, first version>>
    +calculate_positive_weights(labels_csv)
    +train_one_epoch()
    +validate()
    +main()
  }
  class train_dual_task11 {
    <<built script>>
    +train_seed(seed) best checkpoint
    +train_epoch()
    +evaluate() cataract, glaucoma and mean AUROC
    +upsert_csv()
  }
  class train_glaucoma_and_cataract {
    <<built scripts>>
    +train_seed(seed) best checkpoint
    +train_one_epoch()
    +validate() AUROC
    +save_result()
    +save_training_history()
  }
  class quality_check {
    <<built script>>
    +check(photo) status, reason
  }
  class Calibrator {
    <<built>>
    +fit_platt_scaling(logits, labels) scale, offset
    +select_threshold(probabilities, labels) cutoff
    +choose_margin(probabilities, threshold) uncertain band
    +decision_metrics() refer, uncertain, no concern
  }
  class evaluate_internal_test {
    <<built script>>
    +run_preflight() frozen settings and paths
    +load_models(kind, seed) shared or single-disease
